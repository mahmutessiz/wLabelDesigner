<Window x:Class="wLabelDesigner.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print label"
        Width="1040"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PrimaryPrintButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="CalibrationTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="112" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Print preview" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LabelDescription}" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource CanvasWorkspaceBrush}" Margin="0">
                <Viewbox Margin="48" Stretch="Uniform">
                    <Border Width="{Binding PreviewWidth}"
                            Height="{Binding PreviewHeight}"
                            Background="White"
                            BorderBrush="#AAB4C3"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2" />
                        </Border.Effect>
                        <Grid>
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Rectangle Margin="{Binding PreviewMargin}"
                                       Stroke="#7C3AED"
                                       StrokeThickness="1"
                                       StrokeDashArray="4,3"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>

            <Border Grid.Column="1" Padding="24" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="PRINT SETTINGS" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Printer" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Printers}"
                              SelectedItem="{Binding SelectedPrinter}"
                              MaxDropDownHeight="240" />
                    <TextBlock Text="No Windows printers are available."
                               Foreground="#B42318"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanPrint}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Copies" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                    <Grid Width="180" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="−"
                                FontSize="18"
                                Padding="0"
                                Command="{Binding DecreaseCopiesCommand}" />
                        <TextBox Grid.Column="1"
                                 Margin="6,0"
                                 Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="+"
                                FontSize="18"
                                Padding="0"
                                Command="{Binding IncreaseCopiesCommand}" />
                    </Grid>

                    <TextBlock Text="Printer margins (mm)" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,0,8,10">
                            <TextBlock Text="Left" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding MarginLeftMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Top" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding MarginTopMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding MarginRightMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Bottom" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding MarginBottomMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Calibration offset (mm)" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="X · horizontal" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding OffsetXMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Y · vertical" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource CalibrationTextBox}"
                                     Text="{Binding OffsetYMillimeters, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Positive X moves content right; positive Y moves it down. The dashed outline shows the printable area."
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <Border Margin="0,22,0,0" Padding="14" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Document defaults" FontWeight="SemiBold" />
                            <TextBlock Text="The selected printer and number of copies are stored in this label template when you save it."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="20,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFBFC">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,10,0" />
                <Button Content="Print"
                        IsDefault="True"
                        IsEnabled="{Binding CanPrint}"
                        Style="{StaticResource PrimaryPrintButton}"
                        Click="Print_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
