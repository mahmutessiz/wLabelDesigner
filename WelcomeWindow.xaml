<Window x:Class="wLabelDesigner.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to wLabel Designer"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FC">
    <Window.Resources>
        <Style x:Key="LanguageToggle" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E0E7FF" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,8" />
        </Style>

        <Style x:Key="WelcomePrimaryButton" TargetType="Button" BasedOn="{StaticResource WelcomeActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="48,36,48,34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <Border Width="48" Height="48" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="12">
                    <TextBlock Text="W" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Create your next label" Margin="0,18,0,5" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Start with a ready-made layout, a blank label, or one of your saved templates."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <RadioButton Content="English" GroupName="Language" Style="{StaticResource LanguageToggle}"
                             IsChecked="{Binding IsEnglish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                <RadioButton Content="Turkish" GroupName="Language" Style="{StaticResource LanguageToggle}"
                             IsChecked="{Binding IsTurkish, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="tr" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="STARTER LAYOUTS" Style="{StaticResource SectionHeading}" Margin="0,30,0,12" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Layouts}"
                 SelectedItem="{Binding SelectedLayout}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,14,14" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Padding="18" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Cursor="Hand">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="#A5B4FC" />
                                        <Setter TargetName="Card" Property="Background" Value="#FAFAFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="Card" Property="Background" Value="#F5F3FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="112">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Background="White" BorderBrush="#98A2B3"
                                BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Margin="8">
                                <Rectangle Height="4" Fill="#667085" VerticalAlignment="Top" />
                                <Rectangle Height="3" Width="36" Fill="#D0D5DD" VerticalAlignment="Top" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="28" HorizontalAlignment="Center">
                                    <Rectangle Width="2" Fill="#344054" Margin="1,0" />
                                    <Rectangle Width="1" Fill="#344054" Margin="1,0" />
                                    <Rectangle Width="3" Fill="#344054" Margin="1,0" />
                                    <Rectangle Width="1" Fill="#344054" Margin="1,0" />
                                    <Rectangle Width="2" Fill="#344054" Margin="1,0" />
                                    <Rectangle Width="3" Fill="#344054" Margin="1,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,6,0,8" Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" MaxHeight="38" />
                            <TextBlock Text="{Binding Size}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open existing template" Command="{Binding OpenExistingCommand}" Style="{StaticResource WelcomeActionButton}" />
                <Button Content="Start blank" Command="{Binding CreateBlankCommand}" Style="{StaticResource WelcomeActionButton}" Margin="10,0,0,0" />
            </StackPanel>
            <Button Content="Use selected layout" Command="{Binding UseSelectedLayoutCommand}" Style="{StaticResource WelcomePrimaryButton}"
                    HorizontalAlignment="Right" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
