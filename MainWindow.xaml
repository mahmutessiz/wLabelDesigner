<Window x:Class="wLabelDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:wLabelDesigner.Converters"
        xmlns:controls="clr-namespace:wLabelDesigner.Controls"
        xmlns:models="clr-namespace:wLabelDesigner.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="850"
        MinWidth="1080"
        MinHeight="680"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_KeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:MillimetersToDeviceIndependentPixelsConverter x:Key="MmToDip" />
        <converters:LabelElementImageConverter x:Key="ElementImage" />
        <converters:EnumEqualsConverter x:Key="EnumEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TopActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource TopActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="PaletteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FormatToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5B4FC" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlignmentOption" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E0E7FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A5B4FC" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Panel.ZIndex" Value="20" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1.5"
                                CornerRadius="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NonLineResizeThumbStyle" TargetType="Thumb" BasedOn="{StaticResource ResizeThumbStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Line}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="-5" />
            <Setter Property="Panel.ZIndex" Value="21" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Line}" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineStartThumbStyle" TargetType="Thumb" BasedOn="{StaticResource LineResizeThumbStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLineDirectionReversed}" Value="True">
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LineEndThumbStyle" TargetType="Thumb" BasedOn="{StaticResource LineResizeThumbStyle}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLineDirectionReversed}" Value="True">
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RotationThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,-14,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Panel.ZIndex" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Line X1="9" Y1="12" X2="9" Y2="28" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Width="12" Height="12" VerticalAlignment="Top" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DesignerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Panel.ZIndex" Value="0" />
            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource MmToDip}}" />
            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource MmToDip}}" />
            <Setter Property="Width" Value="{Binding Width, Converter={StaticResource MmToDip}}" />
            <Setter Property="Height" Value="{Binding Height, Converter={StaticResource MmToDip}}" />
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="{Binding RotationDegrees}" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder" BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10000" />
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#0D4F46E5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource CanvasWorkspaceBrush}">
        <Menu DockPanel.Dock="Top" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Print…" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="Export as _PNG…" Command="{Binding ExportPngCommand}" />
                <MenuItem Header="Export as P_DF…" Command="{Binding ExportPdfCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <MenuItem Header="D_uplicate" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
                <Separator />
                <MenuItem Header="Deselect _all" Command="{Binding DeselectAllCommand}" InputGestureText="Esc" />
                <MenuItem Header="_Delete selected" Command="{Binding DeleteSelectedCommand}" InputGestureText="Delete" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="_Actual size" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="Show _grid" IsCheckable="True" IsChecked="{Binding IsGridVisible}" />
                <MenuItem Header="Show _rulers" IsCheckable="True" IsChecked="{Binding AreRulersVisible}" />
                <Separator />
                <MenuItem Header="Language">
                    <MenuItem Header="English"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglish, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="en" />
                    <MenuItem Header="Turkish"
                              IsCheckable="True"
                              IsChecked="{Binding IsTurkish, Mode=OneWay}"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="tr" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Arrange">
                <MenuItem Header="Bring to _front" Command="{Binding BringToFrontCommand}" />
                <MenuItem Header="Bring _forward" Command="{Binding BringForwardCommand}" />
                <MenuItem Header="Send _backward" Command="{Binding SendBackwardCommand}" />
                <MenuItem Header="Send to _back" Command="{Binding SendToBackCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User guide" InputGestureText="F1" Click="Help_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Height="52" Margin="10,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource TopActionButton}" />
                        <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryActionButton}" Margin="8,0,2,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="New" Command="{Binding NewDocumentCommand}" Style="{StaticResource TopActionButton}" />
                        <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource TopActionButton}" />
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource TopActionButton}" />
                        <Separator Margin="8,10" />
                        <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource TopActionButton}" ToolTip="Undo (Ctrl+Z)" />
                        <Button Content="Redo" Command="{Binding RedoCommand}" Style="{StaticResource TopActionButton}" ToolTip="Redo (Ctrl+Y)" />
                        <Separator Margin="8,10" />
                        <TextBlock Text="Label" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0,6,0" />
                        <TextBox Width="160" Text="{Binding DocumentName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="W" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0,5,0" />
                        <TextBox Width="58" Text="{Binding LabelWidth, UpdateSourceTrigger=PropertyChanged, Delay=75}" />
                        <TextBlock Text="×" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0" />
                        <TextBox Width="58" Text="{Binding LabelHeight, UpdateSourceTrigger=PropertyChanged, Delay=75}" />
                        <TextBlock Text="mm" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0,14,0" />
                        <ComboBox Width="82" ItemsSource="{Binding SupportedDpi}" SelectedItem="{Binding PrinterDpi}" />
                        <TextBlock Text="DPI" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="5,0" />
                    </StackPanel>
                </DockPanel>

                <Border Height="48" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Select an element to show formatting controls"
                                   Grid.ColumnSpan="2"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFormattingSelection}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasTextSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="TEXT" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding AvailableFontFamilies}"
                                      SelectedItem="{Binding SelectedElement.FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="72"
                                      Margin="8,0,6,0"
                                      IsEditable="True"
                                      ItemsSource="{Binding CommonFontSizes}"
                                      Text="{Binding SelectedElement.FontSize, UpdateSourceTrigger=PropertyChanged, Delay=75}" />
                            <ToggleButton Content="B"
                                          FontWeight="Bold"
                                          Style="{StaticResource FormatToggle}"
                                          IsChecked="{Binding SelectedElement.IsBold}" />
                            <ToggleButton Content="I"
                                          FontStyle="Italic"
                                          Style="{StaticResource FormatToggle}"
                                          IsChecked="{Binding SelectedElement.IsItalic}" />
                            <ToggleButton Style="{StaticResource FormatToggle}"
                                          IsChecked="{Binding SelectedElement.IsUnderlined}">
                                <TextBlock Text="U" TextDecorations="Underline" />
                            </ToggleButton>
                            <Separator Margin="8,8" />
                            <RadioButton ToolTip="Align left"
                                         GroupName="TextAlignment"
                                         Style="{StaticResource AlignmentOption}"
                                         IsChecked="{Binding SelectedElement.TextAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Left}">
                                <TextBlock Text="≡" Width="16" TextAlignment="Left" />
                            </RadioButton>
                            <RadioButton ToolTip="Align center"
                                         GroupName="TextAlignment"
                                         Style="{StaticResource AlignmentOption}"
                                         IsChecked="{Binding SelectedElement.TextAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Center}">
                                <TextBlock Text="≡" Width="16" TextAlignment="Center" />
                            </RadioButton>
                            <RadioButton ToolTip="Align right"
                                         GroupName="TextAlignment"
                                         Style="{StaticResource AlignmentOption}"
                                         IsChecked="{Binding SelectedElement.TextAlignment, Converter={StaticResource EnumEquals}, ConverterParameter=Right}">
                                <TextBlock Text="≡" Width="16" TextAlignment="Right" />
                            </RadioButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasShapeSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="SHAPE" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Stroke" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <ComboBox Width="76"
                                      IsEditable="True"
                                      ItemsSource="{Binding CommonStrokeWidths}"
                                      Text="{Binding SelectedElement.StrokeThickness, UpdateSourceTrigger=PropertyChanged, Delay=75}" />
                            <TextBlock Text="px" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="MULTI" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="Left" Command="{Binding AlignSelectionCommand}" CommandParameter="Left" Style="{StaticResource TopActionButton}" ToolTip="Align left edges" />
                            <Button Content="Center" Command="{Binding AlignSelectionCommand}" CommandParameter="HorizontalCenter" Style="{StaticResource TopActionButton}" ToolTip="Align horizontal centers" />
                            <Button Content="Right" Command="{Binding AlignSelectionCommand}" CommandParameter="Right" Style="{StaticResource TopActionButton}" ToolTip="Align right edges" />
                            <Separator Margin="6,8" />
                            <Button Content="Top" Command="{Binding AlignSelectionCommand}" CommandParameter="Top" Style="{StaticResource TopActionButton}" ToolTip="Align top edges" />
                            <Button Content="Middle" Command="{Binding AlignSelectionCommand}" CommandParameter="VerticalCenter" Style="{StaticResource TopActionButton}" ToolTip="Align vertical centers" />
                            <Button Content="Bottom" Command="{Binding AlignSelectionCommand}" CommandParameter="Bottom" Style="{StaticResource TopActionButton}" ToolTip="Align bottom edges" />
                            <Separator Margin="6,8" />
                            <Button Content="Space H" Command="{Binding DistributeSelectionCommand}" CommandParameter="Horizontal" Style="{StaticResource TopActionButton}" ToolTip="Distribute horizontally (3 or more)" />
                            <Button Content="Space V" Command="{Binding DistributeSelectionCommand}" CommandParameter="Vertical" Style="{StaticResource TopActionButton}" ToolTip="Distribute vertically (3 or more)" />
                        </StackPanel>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasDataElementSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="DATA" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="Content" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox Width="300"
                                     Text="{Binding SelectedElement.Content, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Barcode or QR code content" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0"
                                    Visibility="{Binding HasSingleSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedElement.DisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <CheckBox Content="Visible" IsChecked="{Binding SelectedElement.IsVisible}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <CheckBox Content="Lock position"
                                      IsChecked="{Binding SelectedElement.IsLocked}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0"
                                      ToolTip="Prevent the element from being moved" />
                            <TextBlock Text="Rotate" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="58"
                                     Text="{Binding SelectedElement.RotationDegrees, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="Rotation in degrees" />
                            <TextBlock Text="°" VerticalAlignment="Center" Margin="4,0,6,0" />
                            <Slider Width="110"
                                    Minimum="-180"
                                    Maximum="180"
                                    Value="{Binding SelectedElement.RotationDegrees}"
                                    TickFrequency="15"
                                    IsSnapToTickEnabled="False"
                                    ToolTip="Rotate selected element" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem Content="{Binding StatusMessage}" />
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{Binding LabelWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding LabelHeight, Mode=OneWay}" /><Run Text=" mm" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Content="{Binding PrinterDpi, StringFormat={}{0} DPI}" />
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Button Content="−" Command="{Binding ZoomOutCommand}" MinWidth="28" MinHeight="24" Padding="5,0" ToolTip="Zoom out" />
                    <Button Content="{Binding ZoomPercent, StringFormat={}{0:0}%}" Command="{Binding ResetZoomCommand}" MinWidth="56" MinHeight="24" Padding="5,0" ToolTip="Reset zoom to 100%" />
                    <Button Content="+" Command="{Binding ZoomInCommand}" MinWidth="28" MinHeight="24" Padding="5,0" ToolTip="Zoom in" />
                    <CheckBox Content="Grid" IsChecked="{Binding IsGridVisible}" VerticalAlignment="Center" Margin="14,0,4,0" />
                    <ComboBox Width="62" MinHeight="24" IsEditable="True" ItemsSource="{Binding CommonGridSizes}" Text="{Binding GridSize, UpdateSourceTrigger=PropertyChanged, Delay=100}" ToolTip="Grid size in millimetres" />
                    <TextBlock Text="mm" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0,10,0" />
                    <CheckBox Content="Rulers" IsChecked="{Binding AreRulersVisible}" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12,16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <Button Tag="{x:Static models:LabelElementKind.Text}"
                            Click="AddTextButton_Click"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Text — click to add or drag onto the label">
                        <TextBlock Text="A" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18" />
                    </Button>
                    <Button Tag="{x:Static models:LabelElementKind.Barcode}"
                            Command="{Binding AddBarcodeCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Barcode — click to add or drag onto the label">
                        <TextBlock Text="𝄃𝄂𝄂𝄀𝄁𝄃𝄂𝄂𝄃" Foreground="#15803D" FontSize="20" />
                    </Button>
                    <Button Tag="{x:Static models:LabelElementKind.QrCode}"
                            Command="{Binding AddQrCodeCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="QR code — click to add or drag onto the label">
                        <TextBlock Text="⚄" Foreground="#C2410C" FontSize="20" />
                    </Button>
                    <Button Tag="{x:Static models:LabelElementKind.Image}"
                            Command="{Binding AddImageCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Image or logo — click to import or drag onto the label">
                        <Grid Width="22" Height="18">
                            <Border BorderBrush="#0369A1" BorderThickness="1.5" CornerRadius="2" />
                            <Path Data="M 3,14 L 8,9 L 11,12 L 14,8 L 19,14 Z" Fill="#0EA5E9" />
                            <Ellipse Width="4" Height="4" Fill="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                        </Grid>
                    </Button>
                    <Separator Margin="0,4,0,12" />
                    <Button Tag="{x:Static models:LabelElementKind.Rectangle}"
                            Command="{Binding AddRectangleCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Box — click to add or drag onto the label">
                        <Border Width="20" Height="15" BorderBrush="{StaticResource TextBrush}" BorderThickness="1.5" />
                    </Button>
                    <Button Tag="{x:Static models:LabelElementKind.RoundedRectangle}"
                            Command="{Binding AddRoundedRectangleCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Rounded box — click to add or drag onto the label">
                        <Border Width="20" Height="15" BorderBrush="{StaticResource TextBrush}" BorderThickness="1.5" CornerRadius="4" />
                    </Button>
                    <Button Tag="{x:Static models:LabelElementKind.Line}"
                            Command="{Binding AddLineCommand}"
                            PreviewMouseLeftButtonDown="ToolboxItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolboxItem_PreviewMouseMove"
                            Style="{StaticResource PaletteButton}"
                            ToolTip="Line — click to add or drag onto the label">
                        <Border Width="22" Height="1.5" Background="{StaticResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><RotateTransform Angle="-20" /></Border.RenderTransform>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1"
                  Background="White"
                  PreviewMouseLeftButtonDown="Workspace_PreviewMouseLeftButtonDown">
                <ScrollViewer x:Name="WorkspaceScrollViewer"
                              Background="White"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="56"
                              PreviewMouseWheel="Workspace_PreviewMouseWheel"
                              PreviewMouseDown="Workspace_PreviewMouseDown"
                              PreviewMouseMove="Workspace_PreviewMouseMove"
                              PreviewMouseUp="Workspace_PreviewMouseUp"
                              LostMouseCapture="Workspace_LostMouseCapture">
                    <Grid x:Name="ZoomSurface" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                        </Grid.LayoutTransform>
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="CanvasPanTransform" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition>
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="22" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreRulersVisible}" Value="False"><Setter Property="Height" Value="0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition>
                                <RowDefinition.Style>
                                    <Style TargetType="RowDefinition">
                                        <Setter Property="Height" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreRulersVisible}" Value="False"><Setter Property="Height" Value="0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </RowDefinition.Style>
                            </RowDefinition>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="22" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreRulersVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AreRulersVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1"
                                Visibility="{Binding AreRulersVisible, Converter={StaticResource BoolToVisibility}}" />
                        <controls:DesignerRuler Grid.Row="0" Grid.Column="2"
                                                Width="{Binding LabelWidth, Converter={StaticResource MmToDip}}"
                                                Height="22"
                                                Length="{Binding LabelWidth}"
                                                Visibility="{Binding AreRulersVisible, Converter={StaticResource BoolToVisibility}}" />
                        <controls:DesignerRuler Grid.Row="2" Grid.Column="0"
                                                Width="22"
                                                Height="{Binding LabelHeight, Converter={StaticResource MmToDip}}"
                                                Length="{Binding LabelHeight}"
                                                Orientation="Vertical"
                                                Visibility="{Binding AreRulersVisible, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.Row="2"
                            Grid.Column="2"
                            Width="{Binding LabelWidth, Converter={StaticResource MmToDip}}"
                            Height="{Binding LabelHeight, Converter={StaticResource MmToDip}}"
                            Background="White"
                            BorderBrush="#AAB4C3"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" />
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                        <controls:DesignerGrid GridSize="{Binding GridSize}"
                                               Visibility="{Binding IsGridVisible, Converter={StaticResource BoolToVisibility}}"
                                               IsHitTestVisible="False" />
                        <ListBox x:Name="DesignerCanvas"
                                 ItemsSource="{Binding Elements}"
                                 SelectionChanged="DesignerCanvas_SelectionChanged"
                                 SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource DesignerItemStyle}"
                                 AllowDrop="True"
                                 Drop="DesignerCanvas_Drop"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ClipToBounds="False" ToolTip="{Binding DisplayName}">
                                        <TextBlock x:Name="PreviewText"
                                                   Text="{Binding Content}"
                                                   FontFamily="{Binding FontFamily}"
                                                   FontSize="{Binding FontSize}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Stretch"
                                                   HorizontalAlignment="Stretch" />
                                        <TextBox x:Name="InlineTextEditor"
                                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{Binding FontFamily}"
                                                 FontSize="{Binding FontSize}"
                                                 Padding="2,0"
                                                 BorderThickness="0"
                                                 Background="White"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Top"
                                                 Visibility="Collapsed"
                                                 LostKeyboardFocus="InlineTextEditor_LostKeyboardFocus"
                                                 PreviewKeyDown="InlineTextEditor_PreviewKeyDown" />
                                        <Border x:Name="ShapePreview"
                                                Margin="1"
                                                Background="Transparent"
                                                BorderBrush="Black"
                                                BorderThickness="{Binding StrokeThickness}"
                                                Visibility="Collapsed" />
                                        <Line x:Name="LinePreview"
                                              X1="0"
                                              Y1="0"
                                              X2="100"
                                              Y2="100"
                                              Stretch="Fill"
                                              Stroke="Black"
                                              StrokeThickness="{Binding StrokeThickness}"
                                              SnapsToDevicePixels="True"
                                              Visibility="Collapsed" />
                                        <Image x:Name="PreviewImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Visibility="Collapsed">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource ElementImage}">
                                                    <Binding Path="Content" />
                                                    <Binding Path="Kind" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                        <Thumb Cursor="SizeAll"
                                               PreviewMouseLeftButtonDown="DesignerItem_PreviewMouseLeftButtonDown"
                                               DragStarted="DesignerItem_DragStarted"
                                               DragDelta="DesignerItem_DragDelta"
                                               DragCompleted="DesignerItem_DragCompleted">
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Template">
                                                        <Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Cursor" Value="Arrow" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                        <Thumb Tag="NW" Margin="-4,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="N" Margin="0,-4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="NE" Margin="0,-4,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="E" Margin="0,0,-4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWE" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="SE" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="S" Margin="0,0,0,-4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="SW" Margin="-4,0,0,-4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="W" Margin="-4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" Style="{StaticResource NonLineResizeThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="LineStart" Style="{StaticResource LineStartThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Tag="LineEnd" Style="{StaticResource LineEndThumbStyle}" DragDelta="DesignerItem_ResizeDelta" />
                                        <Thumb Style="{StaticResource RotationThumbStyle}"
                                               ToolTip="Drag to rotate; hold Shift to snap to 15°"
                                               DragStarted="DesignerItem_RotationStarted"
                                               DragDelta="DesignerItem_RotationDelta"
                                               DragCompleted="DesignerItem_RotationCompleted" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="InlineTextEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                                            <Setter TargetName="PreviewText" Property="FontWeight" Value="Bold" />
                                            <Setter TargetName="InlineTextEditor" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsItalic}" Value="True">
                                            <Setter TargetName="PreviewText" Property="FontStyle" Value="Italic" />
                                            <Setter TargetName="InlineTextEditor" Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUnderlined}" Value="True">
                                            <Setter TargetName="PreviewText" Property="TextDecorations" Value="Underline" />
                                            <Setter TargetName="InlineTextEditor" Property="TextDecorations" Value="Underline" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TextAlignment}" Value="{x:Static models:TextAlignmentOption.Left}">
                                            <Setter TargetName="PreviewText" Property="TextAlignment" Value="Left" />
                                            <Setter TargetName="InlineTextEditor" Property="TextAlignment" Value="Left" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TextAlignment}" Value="{x:Static models:TextAlignmentOption.Right}">
                                            <Setter TargetName="PreviewText" Property="TextAlignment" Value="Right" />
                                            <Setter TargetName="InlineTextEditor" Property="TextAlignment" Value="Right" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Barcode}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PreviewImage" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.QrCode}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PreviewImage" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="PreviewImage" Property="Stretch" Value="Uniform" />
                                            <Setter TargetName="PreviewImage" Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Image}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="PreviewImage" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="PreviewImage" Property="Stretch" Value="Uniform" />
                                            <Setter TargetName="PreviewImage" Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Rectangle}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ShapePreview" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.RoundedRectangle}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ShapePreview" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ShapePreview" Property="CornerRadius" Value="8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LabelElementKind.Line}">
                                            <Setter TargetName="PreviewText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="LinePreview" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLineDirectionReversed}" Value="True">
                                            <Setter TargetName="LinePreview" Property="Y1" Value="100" />
                                            <Setter TargetName="LinePreview" Property="Y2" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Canvas IsHitTestVisible="False" ClipToBounds="True">
                            <Line x:Name="VerticalAlignmentGuide" Y1="0" Y2="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}" Stroke="#E11D48" StrokeThickness="0.8" Visibility="Collapsed" />
                            <Line x:Name="HorizontalAlignmentGuide" X1="0" X2="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" Stroke="#E11D48" StrokeThickness="0.8" Visibility="Collapsed" />
                        </Canvas>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2"
                    Width="320"
                    Padding="20"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LAYERS · FRONT TO BACK" Style="{StaticResource SectionHeading}" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,10,0,0">
                        <Button Content="Front" Command="{Binding BringToFrontCommand}" ToolTip="Bring to front" Margin="2" Padding="4" />
                        <Button Content="Up" Command="{Binding BringForwardCommand}" ToolTip="Bring forward" Margin="2" Padding="4" />
                        <Button Content="Down" Command="{Binding SendBackwardCommand}" ToolTip="Send backward" Margin="2" Padding="4" />
                        <Button Content="Back" Command="{Binding SendToBackCommand}" ToolTip="Send to back" Margin="2" Padding="4" />
                    </UniformGrid>
                    <ListBox ItemsSource="{Binding LayerElements}"
                             SelectedItem="{Binding SelectedElement, Mode=TwoWay}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <CheckBox Grid.Column="1" Content="Show" IsChecked="{Binding IsVisible}" Margin="8,0" ToolTip="Show or hide element" />
                                    <CheckBox Grid.Column="2" Content="Lock" IsChecked="{Binding IsLocked}" ToolTip="Lock or unlock element position" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
