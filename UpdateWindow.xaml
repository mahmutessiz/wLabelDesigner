<Window x:Class="wLabelDesigner.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="DialogAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
            <Grid Height="48" Margin="24,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/logo.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="wLabelDesigner" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="32" MinHeight="30" Height="30"
                        Padding="0" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"
                        ToolTip="{Binding CloseWindowLabel}" AutomationProperties.Name="{Binding CloseWindowLabel}" />
            </Grid>
            <StackPanel Margin="32,20,32,28">
                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource SubtleAccentBrush}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="28"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Eyebrow}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Margin="0,24,0,8" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" FontSize="14" LineHeight="22" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                <Border Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,24,0,0"
                        Visibility="{Binding ShowVersions, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition Width="40" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentVersionLabel}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CurrentVersionText}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding LatestVersionLabel}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding LatestVersionText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Visibility="{Binding ShowDownload, Converter={StaticResource VisibleWhenTrue}}" Margin="0,20,0,0">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" LineHeight="20" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProgressLabel}" FontSize="12" />
                        </DockPanel>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" BorderThickness="0"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SubtleAccentBrush}"
                                     AutomationProperties.Name="{Binding ProgressLabel}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Border Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,20" CornerRadius="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding FooterNote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16"
                               Visibility="{Binding ShowDownload, Converter={StaticResource VisibleWhenTrue}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelLabel}" Command="{Binding DownloadCancelCommand}" Style="{StaticResource DialogAction}"
                                Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,10,0" />
                        <Button Content="{Binding CloseLabel}" IsCancel="True" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DialogAction}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding ShowDownload}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="IsDefault" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" Style="{StaticResource DialogAction}" IsDefault="True"
                                Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="White"
                                Visibility="{Binding ShowDownload, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
